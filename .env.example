# =====================================================================
# CICLO · variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local                 # local | preview | production
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                # SÓ no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=

# --- Cofre criptográfico ---
# 32 bytes em base64. Gere com: openssl rand -base64 32
# Em produção, use KMS. Perder esta chave = perder toda anamnese do sistema.
VAULT_KEK=
VAULT_KEK_VERSION=1
# Só durante uma rotação (auditoria de segurança, achado S8). Ponha aqui a KEK ANTIGA, mova a nova
# para VAULT_KEK, some 1 em VAULT_KEK_VERSION e rode `node scripts/rotacionar-kek.mjs --aplicar`.
# Enquanto as duas existirem, o cofre abre com qualquer uma. Remova depois que o script terminar.
VAULT_KEK_PREVIOUS=
# Sal por instalação, usado no hash de telefone (não é segredo criptográfico, mas não vaze)
PHONE_HASH_SALT=

# --- Pagamentos (Asaas) ---
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_SECRET=
ASAAS_WALLET_ID=                          # conta principal para split

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=                    # usado no handshake do webhook
WHATSAPP_APP_SECRET=                      # valida X-Hub-Signature-256

# --- Rate limit (Upstash Redis — única exceção ao "sem Redis") ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CAPTCHA ---
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Push (Web Push / VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@ciclo.app

# --- E-mail transacional ---
RESEND_API_KEY=
EMAIL_FROM="CICLO <nao-responda@ciclo.app>"

# --- Observabilidade ---
SENTRY_DSN=                               # servidor e edge
NEXT_PUBLIC_SENTRY_DSN=                   # navegador — DSN não é segredo, mesmo valor do de cima
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                        # só para upload de source map no build; sem ele o build segue sem subir mapa
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- IA (V2 — deixar vazio no MVP) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Jobs ---
CRON_SECRET=                              # protege os endpoints de worker (bearer do Vercel Cron)
JOB_BATCH_SIZE=50

# --- Links públicos ---
# Assina os links sem login entregues por WhatsApp (confirmação de agendamento, avaliação,
# lista de espera, orçamento). Chave SEPARADA do CRON_SECRET de propósito: são domínios de
# confiança diferentes, e vazar um não pode entregar o outro (auditoria de segurança S1).
# Sem ela, o CRON_SECRET ainda é usado — o deploy não quebra antes de você criar a variável.
# Gere com: openssl rand -base64 32
PUBLIC_LINK_SIGNING_KEY=

# --- Flags ---
# APOSENTADAS em 2026-08-24 (docs/18-MONETIZACAO-PLANO.md §L.3).
#
# Eram quatro: FEATURE_AI_RECEPTIONIST, FEATURE_CLUB, FEATURE_COMMISSION_ADVANCED e
# FEATURE_MULTI_UNIT. Nenhuma linha do projeto jamais leu qualquer uma delas — e, sendo variáveis
# de ambiente, são GLOBAIS: não conseguem, por natureza, ligar funcionalidade por tenant, que é
# exatamente o que um SaaS multi-tenant precisa. Manter variável que promete controle e não
# entrega é dívida que engana quem chega depois.
#
# Quem responde "este tenant pode X?" agora é `src/core/billing/planos.ts`, com os fatos vindos do
# banco (`tenants.plan` + `tenant_modules`) por `src/server/services/planos.ts`.
#
# Elas continuam definidas no Vercel de produção — remover de lá é ação no painel, não no
# repositório. Sem uso, não fazem nada; ficam como lixo de configuração até serem apagadas à mão.
