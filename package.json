{
  "name": "ciclo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --dir tests/unit",
    "test:rls": "vitest run --config vitest.banco.config.ts --dir tests/rls",
    "test:e2e": "node -e \"console.error('test:e2e ainda nao existe: sem playwright instalado, sem playwright.config e tests/e2e vazio. Ver docs/DECISOES.md (31/08).'); process.exit(1)\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm test:rls && pnpm build",
    "db:types": "node scripts/gerar-types.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:new": "supabase migration new",
    "db:types:local": "node scripts/gerar-types.mjs --local",
    "test:integration": "vitest run --config vitest.banco.config.ts --dir tests/integration"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "papaparse": "^5.6.0",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/swc-wasm-nodejs": "15.5.23",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "fast-uri": ">=3.1.6",
      "qs": ">=6.16.0"
    }
  }
}
